{
  "name": "bb-plugin-wayfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Policy-bound browser, desktop, and filesystem flow verification for BB.",
  "repository": {
    "type": "git",
    "url": "https://github.com/g4f4r0/bb-plugins.git",
    "directory": "bb-plugin-wayfinder"
  },
  "scripts": {
    "build": "bb plugin build .",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts tests/server.test.ts tests/host.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.87",
    "node": ">=22"
  },
  "bb": {
    "name": "Wayfinder",
    "description": "Policy-bound browser, desktop, and filesystem flow verification on one shared computer.",
    "branding": {
      "icon": "Route"
    },
    "app": "./app.tsx",
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": []
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@radix-ui/react-slot": "1.3.0",
    "effect": "3.22.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "5.10.1",
    "hono": "4.13.8",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "5.9.3",
    "vaul": "^1.1.2",
    "vitest": "5.0.1"
